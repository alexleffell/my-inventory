# macOS
.DS_Store

# Claude Code local session state / handoffs (not project data)
.remember/
.claude/

# Python
__pycache__/
*.pyc

# transient duplicate-decision queue
data/pending.json

# local-only purchase-request state
data/wishlist.json

# secrets & safety backups - NEVER commit
data/users.json
data/*.bak
data/*.tmp

# admin credentials - NEVER commit
deploy/admin.env

# Your inventory and photos are personal data: never committed. server.py
# creates empty data files on first start; scripts/backup.sh backs them up.
data/inventory.json
data/containers.json
captures/*
!captures/.gitkeep

# 3D model files attached to items (personal data, can be large)
models/
